# A dock with the three things a bot (or a person taking control) needs to hand:
# files, a terminal, a browser — plus the window list and a clock.

rounded = 6
border_width = 0
background_color = #16161a 92
border_color = #ffffff 8

rounded = 4
border_width = 0
background_color = #ffffff 12
border_color = #ffffff 0

panel_monitor = all
# Launcher, taskbar, clock — without this tint2 defaults to taskbar+clock and
# silently drops the launcher icons.
panel_items = LTC
panel_position = bottom center horizontal
panel_size = 100% 44
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_layer = bottom
panel_dock = 0
wm_menu = 1
strut_policy = follow_size

launcher_padding = 6 2 6
launcher_background_id = 0
launcher_icon_size = 26
# Name the theme explicitly: with no GTK settings in the image there is nothing
# for tint2 to infer it from, and unresolved icons render as blanks.
launcher_icon_theme = Adwaita
launcher_icon_theme_override = 1
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/debian-xterm.desktop
launcher_item_app = /usr/share/applications/chromium.desktop
launcher_item_app = /usr/share/applications/org.xfce.mousepad.desktop

taskbar_mode = single_desktop
taskbar_padding = 6 0 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0

task_icon = 1
task_text = 1
task_maximum_size = 190 32
task_padding = 6 2 6
task_background_id = 0
task_active_background_id = 2
task_font_color = #e8e8ea 100
task_active_font_color = #ffffff 100

time1_format = %H:%M
time1_font = Sans 9
time2_format = %a %d %b
time2_font = Sans 7
clock_font_color = #b9b9bf 100
clock_padding = 8 0
clock_background_id = 0

mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify
