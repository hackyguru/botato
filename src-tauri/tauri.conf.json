{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "botcage",
  "version": "0.7.0",
  "identifier": "com.hackyguru.botcage",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "botcage",
        "width": 1100,
        "height": 760,
        "minWidth": 520,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        },
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "deb",
      "appimage",
      "rpm"
    ],
    "resources": {
      "../sandbox/*": "sandbox/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "botcage"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QjRFNkIyQjJGOTRBNTEKUldSUlN2bXlzdWEwdVdJbDBXM1F2eDNyaXRLS3lZNFhmMElIWW1QbjJtSk1vRFpxbmdVekxCbW4K",
      "endpoints": [
        "https://raw.githubusercontent.com/hackyguru/botcage/updater/latest.json"
      ]
    }
  }
}
