<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS will not hand an app the microphone, or the speech recogniser,
       without a sentence explaining why — and it shows that sentence to the
       person being asked. So these are written for them rather than for us.

       Without them the webview's recogniser fails with "service-not-allowed",
       which names the refusal and not the reason. -->

  <key>NSMicrophoneUsageDescription</key>
  <string>botcage uses the microphone only while you hold the talk button on a call with one of your bots.</string>

  <key>NSSpeechRecognitionUsageDescription</key>
  <string>botcage turns what you say on a call into text for your bot to answer. Nothing is recorded or kept.</string>
</dict>
</plist>
