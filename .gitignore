# Expo app
mobile/node_modules
mobile/.expo
mobile/dist

# Built by mobile/rust/build.sh — hundreds of MB of static libraries, and
# regenerated from the crate whenever the bindings change.
mobile/rust/botato-p2p/target
mobile/rust/botato-p2p/jniLibs
mobile/rust/botato-p2p/bindings
mobile/modules/botato-p2p/ios/BotatoP2P.xcframework
mobile/modules/botato-p2p/ios/botato_p2p.swift
mobile/modules/botato-p2p/android/src/main/jniLibs
mobile/modules/botato-p2p/android/src/main/java/uniffi

# Gradle output for the local module
mobile/modules/*/android/build
mobile/modules/*/android/.cxx

# Generated native projects (expo prebuild regenerates them)
mobile/ios

# The marketing site, which is its own repository sitting inside this one.
# Untracked rather than a submodule on purpose — but git add -A will happily
# commit it as a broken gitlink, which it has done once.
website/

# Next.js writes here when its dev server picks this directory as the workspace
# root, which it does because the lockfile it finds first is ours. It is the
# site's build output, not botato's.
.next/

# pnpm content-addressable store, created by a local --store-dir run.
.pnpm-store
